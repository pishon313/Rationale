{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TradeJournal 로컬 앱 권한",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:allow-load",
    "sql:allow-select",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://twelvedata.com/" },
        { "url": "https://eodhd.com/" }
      ]
    }
  ]
}
